[Unit]
Description=SkyLens to MQTT bridge for FEELDSCOPE
After=network-online.target mosquitto.service skylens.service
Wants=network-online.target
Requires=mosquitto.service

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/FEELDSCOPE
ExecStart=/usr/bin/python3 /home/pi/FEELDSCOPE/skylens-mqtt.py
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=skylens-mqtt

[Install]
WantedBy=multi-user.target
