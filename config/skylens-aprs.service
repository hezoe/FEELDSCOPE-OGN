[Unit]
Description=SkyLens to OGN (APRS-IS) uploader for FEELDSCOPE
After=network-online.target mosquitto.service skylens-mqtt.service
Wants=network-online.target
Requires=mosquitto.service

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/FEELDSCOPE
ExecStart=/usr/bin/python3 /home/pi/FEELDSCOPE/skylens-aprs.py
Restart=on-failure
RestartSec=15
StandardOutput=journal
StandardError=journal
SyslogIdentifier=skylens-aprs

[Install]
WantedBy=multi-user.target
